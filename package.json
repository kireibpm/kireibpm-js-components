{
  "name": "kireibpm-js-components",
  "version": "1.0.1",
  "description": "AngularJS UI components and utilities for KireiBPM web applications",
  "main": "dist/bonita-lib.js",
  "style": "dist/bonita-lib.css",
  "scripts": {
    "start": "gulp dev",
    "predist": "gulp predist",
    "dist": "gulp dist",
    "predocumentation": "gulp clean:docs",
    "documentation": "gulp documentation",
    "tdd": "gulp dev & npm run testwatch",
    "pretest": "gulp jshint",
    "test": "karma start karma.conf.js",
    "test:ci": "CI=true karma start karma.conf.js --single-run",
    "testwatch": "karma start karma.conf.js --auto-watch --no-single-run",
    "audit": "yarn audit --level moderate",
    "audit:json": "yarn audit --level moderate --json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kireibpm/kireibpm-js-components.git"
  },
  "author": "",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/kireibpm/kireibpm-js-components/issues"
  },
  "homepage": "https://github.com/kireibpm/kireibpm-js-components",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "angular-mocks": "angular/bower-angular-mocks#1.8.3",
    "del": "0.1.3",
    "gulp": "3.9.1",
    "gulp-cli": "2.3.0",
    "gulp-ngdocs": "0.2.13",
    "gulp-angular-gettext": "2.1.0",
    "gulp-autoprefixer": "1.0.1",
    "gulp-concat": "2.6.0",
    "gulp-connect": "2.2.0",
    "gulp-csso": "0.2.9",
    "gulp-jshint": "1.8.6",
    "gulp-ng-annotate": "0.4.4",
    "gulp-ng-html2js": "0.1.8",
    "gulp-plumber": "0.6.6",
    "gulp-rename": "1.2.2",
    "gulp-minify": "3.1.0",
    "gulp-util": "3.0.6",
    "jasmine-core": "2.4.1",
    "jshint-stylish": "^1.0.0",
    "karma": "1.7.1",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "1.1.2",
    "karma-jasmine": "0.3.5",
    "karma-ng-html2js-preprocessor": "0.1.2"
  },
  "dependencies": {
    "gulp-ngdocs": "0.2.13",
    "angular": "angular/bower-angular#1.8.3",
    "angular-bootstrap": "angular-ui/bootstrap-bower#0.13.4",
    "bootstrap": "twbs/bootstrap#3.4.1",
    "jquery": "jquery/jquery-dist#3.5.1",
    "ng-sortable": "a5hik/ng-sortable#1.3.1",
    "ngstorage": "gsklee/ngStorage#0.3.9"
  },
  "files": [
    "dist/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "yarn": ">= 1.22.0"
  },
  "resolutions": {
    "graceful-fs": "^4.2.11",
    "lodash": "^4.17.21",
    "minimatch": "^3.1.4",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "semver": "^5.7.2",
    "minimist": "0.2.4",
    "morgan": "^1.10.0",
    "socket.io-parser": "3.4.2",
